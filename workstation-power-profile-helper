#!/usr/bin/env bash
set -Eeuo pipefail

readonly STATE_DIR="/var/lib/workstation-power-profile"
readonly STOCK_FILE="${STATE_DIR}/stock.env"

fail() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

[[ ${EUID} -eq 0 ]] || fail "this helper must run as root through sudo or systemd."

NVIDIA_SMI="$(command -v nvidia-smi || true)"
if [[ -x /usr/local/bin/ryzenadj ]]; then
    RYZENADJ=/usr/local/bin/ryzenadj
else
    RYZENADJ="$(command -v ryzenadj || true)"
fi
[[ -n ${NVIDIA_SMI} ]] || fail "nvidia-smi is not installed."
[[ -n ${RYZENADJ} ]] || fail "ryzenadj is not installed or is not in PATH."
"${NVIDIA_SMI}" -L >/dev/null 2>&1 || fail "the NVIDIA driver is not loaded or is not responding."

capture_stock() {
    local info stapm fast slow
    if ! info="$(${RYZENADJ} -i 2>&1)"; then
        if [[ ${info} == *"CPU Family: Dragon Range"* && ${info} == *"does not affect adjustments"* ]]; then
            # RyzenAdj cannot read the Dragon Range PM table. AMD specifies 75 W
            # as maximum cTDP for Ryzen 9 7945HX3D.
            stapm=75000
            fast=75000
            slow=75000
        else
            fail "ryzenadj could not read the CPU: ${info}"
        fi
    fi

    read_limit() {
        local parameter="$1"
        awk -F '|' -v parameter="${parameter}" '
            $3 ~ parameter {
                value=$2
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
                if (value ~ /^[0-9]+([.][0-9]+)?$/) {
                    printf "%.0f\n", value * 1000
                    exit
                }
            }
        ' <<<"${info}"
    }

    if [[ -z ${stapm:-} ]]; then
        stapm="$(read_limit 'stapm-limit')"
        fast="$(read_limit 'fast-limit')"
        slow="$(read_limit 'slow-limit')"
    fi
    [[ ${stapm} =~ ^[0-9]+$ && ${fast} =~ ^[0-9]+$ && ${slow} =~ ^[0-9]+$ ]] \
        || fail "stock limits could not be detected from 'ryzenadj -i'."

    install -d -m 0700 "${STATE_DIR}"
    umask 077
    printf 'STOCK_STAPM=%s\nSTOCK_FAST=%s\nSTOCK_SLOW=%s\n' \
        "${stapm}" "${fast}" "${slow}" >"${STOCK_FILE}"
    printf 'Saved stock CPU limits: STAPM=%s mW, fast=%s mW, slow=%s mW.\n' \
        "${stapm}" "${fast}" "${slow}"
}

apply_limits() {
    local gpu_watts="$1" cpu_milliwatts="$2"
    local output limits gpu_min gpu_max effective_gpu

    limits="$(${NVIDIA_SMI} -i 0 \
        --query-gpu=power.min_limit,power.max_limit \
        --format=csv,noheader,nounits 2>/dev/null | head -n1)"
    IFS=',' read -r gpu_min gpu_max <<<"${limits}"
    gpu_min="${gpu_min//[[:space:]]/}"
    gpu_max="${gpu_max//[[:space:]]/}"
    [[ ${gpu_min} =~ ^[0-9]+([.][0-9]+)?$ && ${gpu_max} =~ ^[0-9]+([.][0-9]+)?$ ]] \
        || fail "the GPU does not publish an adjustable power-limit range."
    effective_gpu="$(awk -v requested="${gpu_watts}" -v minimum="${gpu_min}" -v maximum="${gpu_max}" \
        'BEGIN {
            if (requested < minimum) requested=minimum
            if (requested > maximum) requested=maximum
            printf "%.2f", requested
        }')"

    output="$(${RYZENADJ} \
        --stapm-limit="${cpu_milliwatts}" \
        --fast-limit="${cpu_milliwatts}" \
        --slow-limit="${cpu_milliwatts}" 2>&1)" \
        || fail "ryzenadj failed; the GPU was not changed: ${output}"

    output="$(${NVIDIA_SMI} -i 0 -pl "${effective_gpu}" 2>&1)" \
        || fail "CPU limits were applied, but nvidia-smi rejected ${effective_gpu} W: ${output}"
    EFFECTIVE_GPU="${effective_gpu}"
}

case "${1:-}" in
    capture-defaults)
        [[ ! -e ${STOCK_FILE} || ${2:-} == "--force" ]] \
            || fail "${STOCK_FILE} already exists; use --force only after restoring firmware defaults and rebooting."
        capture_stock
        ;;
    quiet)
        apply_limits 90 30000
        printf 'Quiet Coding applied: GPU %s W, CPU 30 W.\n' "${EFFECTIVE_GPU}"
        ;;
    eco)
        apply_limits 90 35000
        printf 'Eco Dev applied: GPU %s W, CPU 35 W.\n' "${EFFECTIVE_GPU}"
        ;;
    balanced)
        apply_limits 120 45000
        printf 'Balanced applied: GPU %s W, CPU 45 W.\n' "${EFFECTIVE_GPU}"
        ;;
    cpu-focus)
        apply_limits 90 50000
        printf 'CPU Focus applied: GPU %s W, CPU 50 W.\n' "${EFFECTIVE_GPU}"
        ;;
    cpu-max)
        apply_limits 90 75000
        printf 'Max CPU / Min GPU applied: GPU %s W, CPU 75 W.\n' "${EFFECTIVE_GPU}"
        ;;
    ai)
        apply_limits 180 45000
        printf 'Local AI applied: GPU %s W, CPU 45 W.\n' "${EFFECTIVE_GPU}"
        ;;
    custom)
        [[ $# -eq 3 ]] || fail "usage: custom GPU_WATTS CPU_WATTS"
        [[ $2 =~ ^[0-9]+$ && $3 =~ ^[0-9]+$ ]] || fail "custom limits must be whole watts."
        (( $2 >= 1 && $2 <= 1000 )) || fail "GPU limit must be between 1 and 1000 W."
        (( $3 >= 10 && $3 <= 75 )) || fail "CPU limit must be between 10 and 75 W."
        apply_limits "$2" "$(( $3 * 1000 ))"
        printf 'Custom profile applied: GPU %s W, CPU %s W.\n' "${EFFECTIVE_GPU}" "$3"
        ;;
    max)
        [[ -r ${STOCK_FILE} ]] || fail "stock CPU limits are missing; run capture-defaults after rebooting."
        # File is root-owned, mode 0600, and contains only assignments generated above.
        source "${STOCK_FILE}"
        [[ ${STOCK_STAPM:-} =~ ^[0-9]+$ && ${STOCK_FAST:-} =~ ^[0-9]+$ && ${STOCK_SLOW:-} =~ ^[0-9]+$ ]] \
            || fail "${STOCK_FILE} contains invalid values."
        gpu_max="$(${NVIDIA_SMI} -i 0 --query-gpu=power.max_limit --format=csv,noheader,nounits 2>/dev/null | head -n1)"
        gpu_max="${gpu_max//[[:space:]]/}"
        [[ ${gpu_max} =~ ^[0-9]+([.][0-9]+)?$ ]] || fail "could not query the GPU maximum power limit."
        output="$(${RYZENADJ} --max-performance \
            --stapm-limit="${STOCK_STAPM}" \
            --fast-limit="${STOCK_FAST}" \
            --slow-limit="${STOCK_SLOW}" 2>&1)" \
            || fail "ryzenadj could not restore stock CPU limits: ${output}"
        output="$(${NVIDIA_SMI} -i 0 -pl "${gpu_max}" 2>&1)" \
            || fail "CPU limits were restored, but nvidia-smi rejected ${gpu_max} W: ${output}"
        printf 'Max Performance applied: GPU %s W; CPU restored to saved stock limits.\n' "${gpu_max}"
        ;;
    *)
        fail "invalid profile. Use quiet, eco, balanced, cpu-focus, cpu-max, ai, custom, max, or capture-defaults."
        ;;
esac
